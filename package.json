  },
  "dependencies": {
    "fzstd": "^0.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MatsuriMW/obsidian-agent-deck.git"
  },
  "homepage": "https://github.com/MatsuriMW/obsidian-agent-deck",
